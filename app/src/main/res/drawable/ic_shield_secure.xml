<?xml version="1.0" encoding="utf-8"?>
<!--
    Browser-owned icon. Same 24-unit viewport, 1.9 stroke and round caps/joins as the rest of the
    set, so it sits on the same optical grid — no call site can correct for an icon drawn elsewhere.

    Drawn as a shield with a check inside it. The check is not decoration: `UX-021` renders the two
    transport states as green and neutral, and colour may not be the only differentiator, so the
    mark inside the outline is what carries the distinction for anyone who cannot separate the two
    hues. The pair with ic_shield_unverified is deliberately readable at 16 dp.

    Kept separate from ic_lock rather than reusing it. Regular chrome's glyph supports the words
    `Secure · example.com`; this one sits in the integrated header beside a manifest-supplied title,
    where it is the browser's own mark and has to look like one.

    The declared colour never reaches the screen. Compose's Icon applies ColorFilter.tint over the
    whole painter, so the call site's token decides the colour and this value only decides what an
    untinted use would look like.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12 3.2l6.6 2.6v6.1c0 3.8-2.6 7.2-6.6 8.9c-4-1.7-6.6-5.1-6.6-8.9V5.8z"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M8.9 11.9l2.2 2.2l4-4.3"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
