<?xml version="1.0" encoding="utf-8"?>
<!--
    Browser-owned icon. Same 24-unit viewport, 1.9 stroke and round caps/joins as the rest of the
    set, and the same shield outline as ic_shield_secure so the pair reads as one control changing
    state rather than as two unrelated marks.

    Named `unverified`, not `insecure`. It stands for three internal states — UNKNOWN, NOT_SECURE
    and TLS_ERROR — which `UX-021` deliberately renders alike while keeping them distinct in the
    model. A name asserting insecurity would be wrong for the loading case and would invite the next
    reader to give the three separate glyphs, which is the visible three-way mapping the issue's
    non-goals rule out.

    The interior mark is a question, the absence of a claim rather than a warning. A cross or a
    warning triangle would assert danger on a page that is merely still loading.

    The declared colour never reaches the screen; the call site's token decides it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12 3.2l6.6 2.6v6.1c0 3.8-2.6 7.2-6.6 8.9c-4-1.7-6.6-5.1-6.6-8.9V5.8z"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M10.1 10.2a1.9 1.9 0 1 1 2.6 1.8v1.4"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M12.7 15.8v0.1"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
