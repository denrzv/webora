keystore.properties
*.jks
*.keystore
# One exception, and only this one. The debug keystore is the well-known Android debug identity
# (androiddebugkey / "android"), deliberately shared so that demo builds from CI and from a
# developer's machine sign identically and can therefore be installed over one another. It carries
# no security value and cannot sign a release build. Every other keystore stays excluded above.
!app/debug.keystore
/.kotlin/

# Screenshot-evidence staging, created at the repository root by the Android screenshots
# workflow: review/ becomes the human-facing artifact, artifacts/ the diagnostics one.
# Neither is ever committed — evidence belongs to a run, and a checked-in frame would be
# a screenshot with no commit behind it.
/review/
/artifacts/
